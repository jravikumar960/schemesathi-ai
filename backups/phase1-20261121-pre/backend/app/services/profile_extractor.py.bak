import re


def extract_profile(message: str) -> dict:
    text = message.lower()
    profile = {}

    patterns = [
        r"(?:income|earn|salary)[^\d]{0,50}(?:rs\.?|₹|inr)?\s*([\d,]+(?:\.\d+)?)\s*(lakh|lakhs|lac|lacs|k)?\b",
        r"(?:rs\.?|₹|inr)\s*([\d,]+(?:\.\d+)?)\s*(lakh|lakhs|lac|lacs|k)?\b[^\n.]{0,50}(?:income|earn|salary)",
    ]

    for pattern in patterns:
        match = re.search(pattern, text)
        if not match:
            continue

        amount = float(match.group(1).replace(",", ""))
        unit = match.group(2)

        if unit in ("lakh", "lakhs", "lac", "lacs"):
            amount *= 100000
        elif unit == "k":
            amount *= 1000

        # Do not assume monthly income is annual income.
        if re.search(r"\b(per month|monthly|/month)\b", text):
            profile["monthly_income"] = amount
        elif re.search(r"\b(per year|yearly|annual|annually|/year)\b", text):
            profile["annual_family_income"] = amount
        else:
            profile["income_period_unknown"] = amount

        break

    return profile

def extract_student_context(message: str) -> dict:
    """Extract explicit category and residence mentions."""
    text = message.lower()
    profile = {}

    category_patterns = {
        "SC": r"\b(?:sc|scheduled caste)\b",
        "ST": r"\b(?:st|scheduled tribe)\b",
        "BC": r"\b(?:bc|backward class(?:es)?)\b",
        "EBC": r"\b(?:ebc|economically backward class(?:es)?)\b",
        "MINORITY": r"\bminority\b",
    }

    matches = [
        category
        for category, pattern in category_patterns.items()
        if re.search(pattern, text)
    ]

    if len(matches) == 1:
        profile["category"] = matches[0]

    rural = bool(re.search(r"\b(?:rural|village)\b", text))
    urban = bool(re.search(r"\b(?:urban|city|town)\b", text))

    if rural != urban:
        profile["residence"] = "rural" if rural else "urban"

    return profile


_original_extract_profile = extract_profile


def extract_profile(message: str) -> dict:
    profile = _original_extract_profile(message)
    profile.update(extract_student_context(message))
    return profile
