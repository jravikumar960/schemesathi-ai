from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel, Field
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.database import get_db
from app.models.scheme import Scheme
from app.services.agent import agent
from app.services.profile_extractor import extract_profile
from app.services.privacy import contains_sensitive_information

router = APIRouter(prefix="/chat", tags=["chat"])


class ChatRequest(BaseModel):
    message: str = Field(min_length=1, max_length=2000)


@router.post("")
def chat(payload: ChatRequest, db: Session = Depends(get_db)):
    if contains_sensitive_information(payload.message):
        raise HTTPException(
            status_code=422,
            detail="Do not submit Aadhaar, PAN, passport or other sensitive identification details.",
        )

    profile = extract_profile(payload.message)

    if "income_period_unknown" in profile:
        return {
            "response": (
                "Is the income you mentioned monthly or annual "
                "family income?"
            ),
            "extracted_profile": profile,
            "results": [],
        }

    schemes = db.scalars(
        select(Scheme).order_by(Scheme.id)
    ).all()

    result = agent.invoke({
        "profile": profile,
        "schemes": list(schemes),
    })

    return {
        "response": result["response"],
        "extracted_profile": profile,
        "results": result["results"],
        "disclaimer": (
            "Preliminary assessment using illustrative data. "
            "These are not verified government benefits."
        ),
    }
