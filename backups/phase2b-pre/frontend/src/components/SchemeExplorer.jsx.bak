import { useEffect, useState } from "react";
import { ExternalLink, RefreshCw } from "lucide-react";

export default function SchemeExplorer() {
  const [schemes, setSchemes] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function loadSchemes() {
    setLoading(true);
    setError("");

    try {
      const response = await fetch("/api/schemes");
      if (!response.ok) throw new Error("Unable to load schemes");

      const data = await response.json();
      setSchemes(Array.isArray(data) ? data : data.schemes || []);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadSchemes();
  }, []);

  return (
    <section className="space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-2xl font-bold">Explore schemes</h2>
          <p className="mt-1 text-sm text-slate-500">
            Review eligibility criteria and application guidance.
          </p>
        </div>
        <button
          onClick={loadSchemes}
          className="flex items-center gap-2 rounded-lg border border-slate-300 px-3 py-2 text-sm"
        >
          <RefreshCw size={16} /> Refresh
        </button>
      </div>

      {loading && <p>Loading schemes...</p>}
      {error && <p role="alert" className="text-red-600">{error}</p>}

      <div className="grid gap-5 md:grid-cols-2">
        {schemes.map((scheme) => (
          <article
            key={scheme.slug}
            className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
          >
            <span className={
              scheme.is_illustrative
                ? "rounded-full bg-amber-100 px-3 py-1 text-xs text-amber-800"
                : "rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700"
            }>
              {scheme.is_illustrative
                ? "Illustrative demo — not an official scheme"
                : scheme.verification_status === "VERIFIED"
                  ? "Source-verified record"
                  : "Verification pending"}
            </span>

            <h3 className="mt-4 text-lg font-bold">{scheme.name}</h3>
            <p className="mt-2 text-sm text-slate-600">
              {scheme.description}
            </p>

            <p className="mt-3 text-sm font-medium">
              {scheme.benefit_summary}
            </p>

            <details className="mt-4 rounded-lg bg-slate-50 p-4">
              <summary className="cursor-pointer font-semibold">
                Requirements and application steps
              </summary>

              <h4 className="mt-4 font-semibold">Eligibility conditions</h4>
              <ul className="mt-2 list-disc space-y-1 pl-5 text-sm">
                {(scheme.eligibility_conditions || []).map((rule, i) => (
                  <li key={i}>{rule.description}</li>
                ))}
              </ul>

              <h4 className="mt-4 font-semibold">Documents</h4>
              <ul className="mt-2 list-disc space-y-1 pl-5 text-sm">
                {(scheme.document_requirements || []).map((item, i) => (
                  <li key={i}>{item}</li>
                ))}
              </ul>

              <h4 className="mt-4 font-semibold">Application steps</h4>
              <ol className="mt-2 list-decimal space-y-1 pl-5 text-sm">
                {(scheme.application_steps || []).map((step, i) => (
                  <li key={i}>{step}</li>
                ))}
              </ol>
            </details>

            {!scheme.is_illustrative &&
              scheme.verification_status === "VERIFIED" &&
              scheme.official_url && (
                <a
                  href={scheme.official_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600"
                >
                  Official source <ExternalLink size={15} />
                </a>
              )}
          </article>
        ))}
      </div>

      {!loading && !error && schemes.length === 0 && (
        <p>No schemes are currently available.</p>
      )}
    </section>
  );
}
