import { useEffect, useState } from "react";
import { CalendarClock, ExternalLink, LoaderCircle } from "lucide-react";
import { formatDisplayDate } from "../deadlineLogic";
import { categorizeSchemes } from "../schemeLogic";

const STATUS_BADGES = {
  UPCOMING: { label: "Upcoming", className: "bg-emerald-50 text-emerald-700 border-emerald-200" },
  EXPIRED: { label: "Expired", className: "bg-slate-100 text-slate-500 border-slate-200" },
  UNVERIFIED: { label: "Unverified", className: "bg-amber-50 text-amber-800 border-amber-200" },
  NO_VERIFIED_DEADLINE: { label: "No verified deadline", className: "bg-slate-100 text-slate-600 border-slate-200" },
};

// Returns { ok: true, data } or { ok: false, message }. Never throws.
async function loadDeadlineResult() {
  try {
    const response = await fetch("/api/deadlines");
    const data = await response.json().catch(() => null);
    if (!response.ok) {
      return { ok: false, message: "Unable to load deadlines right now. Please try again." };
    }
    if (!Array.isArray(data)) {
      return { ok: false, message: "Unexpected response from the deadlines service." };
    }
    return { ok: true, data };
  } catch {
    return { ok: false, message: "Unable to reach the deadlines service. Please try again." };
  }
}

function sortDeadlines(items) {
  const daysOf = (item) =>
    Number.isInteger(item.days_remaining) ? item.days_remaining : Number.MAX_SAFE_INTEGER;
  const upcoming = items
    .filter((item) => item.deadline_status === "UPCOMING")
    .sort((a, b) => daysOf(a) - daysOf(b));
  const others = items.filter((item) => item.deadline_status !== "UPCOMING");
  return [...upcoming, ...others];
}

function DeadlineCard({ item, demo = false, unverified = false }) {
  const badge = STATUS_BADGES[item.deadline_status] ?? STATUS_BADGES.UNVERIFIED;
  const deadlineDate = formatDisplayDate(item.deadline);
  const sourceDate = formatDisplayDate(item.source_verified_on);
  const verifiedDate = formatDisplayDate(item.deadline_verified_on);
  const muted = item.deadline_status === "EXPIRED";

  let statusText = null;
  if (item.deadline_status === "UPCOMING") {
    statusText = (
      <div className="space-y-1">
        <p className="font-semibold text-slate-900">Deadline {deadlineDate}</p>
        <p className="text-sm font-medium text-indigo-700">{item.days_remaining} day(s) remaining</p>
      </div>
    );
  } else if (item.deadline_status === "EXPIRED") {
    statusText = <p className="text-sm text-slate-500">Deadline passed on {deadlineDate}</p>;
  } else if (item.deadline_status === "UNVERIFIED") {
    statusText = (
      <p className="text-sm font-medium text-amber-800">
        Deadline not verified — do not rely on it
      </p>
    );
  } else if (item.deadline_status === "NO_VERIFIED_DEADLINE") {
    statusText = (
      <p className="text-sm text-slate-600">
        No verified deadline available. Check the official portal.
      </p>
    );
  }

  return (
    <article
      className={`flex flex-col gap-4 rounded-2xl border p-5 shadow-sm ${
        muted ? "border-slate-200 bg-slate-50" : "border-slate-200 bg-white"
      }`}
    >
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div className="min-w-0 flex-1">
          <h3 className={`font-bold ${muted ? "text-slate-600" : "text-slate-900"}`}>
            {item.name}
          </h3>
          <p className="mt-1 text-xs text-slate-500">
            {item.academic_year
              ? `Academic year ${item.academic_year}`
              : "Academic year not recorded"}
          </p>
        </div>
        <span
          className={`shrink-0 rounded-full border px-3 py-1 text-xs font-semibold ${badge.className}`}
        >
          {badge.label}
        </span>
      </div>

      {statusText}

      <div className="mt-auto space-y-2 border-t border-slate-100 pt-4 text-xs text-slate-500">
        {verifiedDate && <p>Deadline verified: {verifiedDate}</p>}
        {sourceDate && <p>Source recorded: {sourceDate}</p>}
        {!demo && item.official_url ? (
          <a
            href={item.official_url}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center gap-1 font-semibold text-indigo-600 hover:text-indigo-800 hover:underline"
          >
            Official source
            <ExternalLink size={14} />
          </a>
        ) : (
          <p>{demo ? "Illustrative demo record — not an official scholarship" : unverified ? "Programme details awaiting official confirmation" : "Official source not recorded"}</p>
        )}
      </div>
    </article>
  );
}

export default function DeadlineDashboard() {
  const [items, setItems] = useState([]);
  const {
    verified,
    unverified,
    illustrative,
  } = categorizeSchemes(items);
  const [status, setStatus] = useState("loading");
  const [errorMessage, setErrorMessage] = useState("");

  useEffect(() => {
    let active = true;
    loadDeadlineResult().then((result) => {
      if (!active) return;
      if (result.ok) {
        setItems(sortDeadlines(result.data));
        setStatus("ready");
      } else {
        setErrorMessage(result.message);
        setStatus("error");
      }
    });
    return () => {
      active = false;
    };
  }, []);

  function refresh() {
    setStatus("loading");
    setErrorMessage("");
    loadDeadlineResult().then((result) => {
      if (result.ok) {
        setItems(sortDeadlines(result.data));
        setStatus("ready");
      } else {
        setErrorMessage(result.message);
        setStatus("error");
      }
    });
  }

  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
      <div className="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="rounded-xl bg-indigo-50 p-3 text-indigo-600">
            <CalendarClock size={22} />
          </div>
          <div>
            <h2 className="text-2xl font-bold tracking-tight">Deadlines</h2>
            <p className="text-sm text-slate-500">
              Verified scholarship deadlines. Always confirm on the official source.
            </p>
          </div>
        </div>
        <button
          type="button"
          onClick={refresh}
          disabled={status === "loading"}
          className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Refresh
        </button>
      </div>

      {status === "loading" && (
        <div role="status" className="flex items-center gap-3 rounded-2xl bg-slate-50 p-6 text-sm text-slate-600">
          <LoaderCircle size={18} className="animate-spin" />
          Loading deadlines...
        </div>
      )}

      {status === "error" && (
        <div role="alert" className="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">
          <span>{errorMessage}</span>
          <button
            type="button"
            onClick={refresh}
            className="rounded-xl bg-red-700 px-4 py-2 font-semibold text-white transition hover:bg-red-800"
          >
            Retry
          </button>
        </div>
      )}

      {status === "ready" && items.length === 0 && (
        <div className="rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-500">
          No scholarship deadline data is available yet.
        </div>
      )}

      {status === "ready" && items.length > 0 && (
        <div className="space-y-6">
          {verified.length > 0 ? (
            <div className="grid gap-4 md:grid-cols-2">
              {verified.map((item) => (
                <DeadlineCard key={item.slug} item={item} />
              ))}
            </div>
          ) : (
            <p className="rounded-xl bg-slate-50 p-5 text-sm text-slate-600">
              No verified scholarship records are available.
            </p>
          )}

          {unverified.length > 0 && (
            <details className="rounded-2xl border border-amber-200 bg-amber-50 p-5">
              <summary className="cursor-pointer font-semibold text-amber-900">
                Programmes Awaiting Official Confirmation ({unverified.length})
              </summary>
              <p className="mt-3 text-sm text-amber-800">
                These programme records have not been fully verified. Their deadlines
                and eligibility must be confirmed through the relevant government department.
              </p>
              <div className="mt-4 grid gap-4 md:grid-cols-2">
                {unverified.map((item) => (
                  <DeadlineCard key={item.slug} item={item} unverified />
                ))}
              </div>
            </details>
          )}

          {illustrative.length > 0 && (
            <details className="rounded-2xl border border-amber-200 bg-amber-50 p-5">
              <summary className="cursor-pointer font-semibold text-amber-900">
                Illustrative Demo Records ({illustrative.length})
              </summary>
              <p className="mt-3 text-sm text-amber-800">
                These records are for demonstration or require verification.
                Do not treat them as official scholarship opportunities.
              </p>
              <div className="mt-4 grid gap-4 md:grid-cols-2">
                {illustrative.map((item) => (
                  <DeadlineCard key={item.slug} item={item} demo />
                ))}
              </div>
            </details>
          )}
        </div>
      )}
    </div>
  );
}
