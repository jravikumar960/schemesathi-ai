import ScholarshipRecommendation from "./components/ScholarshipRecommendation";
import ApplicationTracker from "./components/ApplicationTracker";
import SchemeExplorer from "./components/SchemeExplorer";
import { useState } from "react";
import {
  GraduationCap,
  Send,
  ShieldCheck,
  Search,
  ClipboardList,
  LoaderCircle,
} from "lucide-react";

export default function App() {
  const [message, setMessage] = useState("");
  const [answer, setAnswer] = useState("");
  const [recommendation, setRecommendation] = useState(null);
  const [profile, setProfile] = useState({});
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  async function checkEligibility(event) {
    event.preventDefault();
    if (!message.trim()) return;

    setLoading(true);
    setError("");
    setAnswer("");
    setRecommendation(null);
    setProfile({});

    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          typeof data.detail === "string"
            ? data.detail
            : "Unable to process your request."
        );
      }

      setAnswer(data.response);
      setRecommendation(data.recommendation || null);
      setProfile(data.extracted_profile || {});
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900">
      <header className="border-b border-slate-200 bg-white">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
          <div className="flex items-center gap-3">
            <div className="rounded-xl bg-indigo-600 p-2 text-white">
              <GraduationCap size={26} />
            </div>
            <div>
              <h1 className="text-xl font-bold">SchemeSathi AI</h1>
              <p className="text-xs text-slate-500">
                Government education benefit assistant
              </p>
            </div>
          </div>
          <span className="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800">
            Development preview
          </span>
        </div>
      </header>

      <main className="mx-auto max-w-6xl space-y-8 px-6 py-10">
        <section className="max-w-3xl">
          <p className="mb-3 text-sm font-semibold uppercase tracking-wider text-indigo-600">
            Student scholarship assistant
          </p>
          <h2 className="text-4xl font-bold tracking-tight">
            Discover education support that fits your situation.
          </h2>
          <p className="mt-4 text-lg text-slate-600">
            Describe your category, residence, and annual family income
            to receive a preliminary scholarship income assessment.
          </p>
        </section>

        <section className="grid gap-6 lg:grid-cols-[1.5fr_1fr]">
          <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 className="mb-2 text-xl font-semibold">
              Check scholarship eligibility
            </h3>
            <p className="mb-5 text-sm text-slate-500">
              Example: I am a BC student from an urban area.
              My annual family income is 1.8 lakh.
            </p>

            <form onSubmit={checkEligibility}>
              <textarea
                className="min-h-36 w-full resize-y rounded-xl border border-slate-300 p-4 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                placeholder="Describe your situation..."
                value={message}
                maxLength={2000}
                onChange={(event) => setMessage(event.target.value)}
              />

              <button
                type="submit"
                disabled={loading || !message.trim()}
                className="mt-4 flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-700 disabled:opacity-50"
              >
                {loading ? (
                  <LoaderCircle className="animate-spin" size={18} />
                ) : (
                  <Send size={18} />
                )}
                {loading ? "Checking..." : "Check eligibility"}
              </button>
            </form>

            {error && (
              <div role="alert" className="mt-5 rounded-xl bg-red-50 p-4 text-sm text-red-700">
                {error}
              </div>
            )}

            {answer && (
              <div className="mt-6 rounded-xl border border-indigo-100 bg-indigo-50 p-5">
                <h4 className="mb-3 font-semibold text-indigo-950">
                  Preliminary assessment
                </h4>
                <p className="whitespace-pre-line text-sm leading-7 text-slate-700">
                  {answer}
                </p>
              </div>
            )}
          </div>

          <aside className="space-y-5">
            <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 className="mb-4 text-lg font-semibold">
                Extracted information
              </h3>

              {Object.keys(profile).length ? (
                <dl className="space-y-3 text-sm">
                  {Object.entries(profile).map(([key, value]) => (
                    <div key={key} className="border-b border-slate-100 pb-2">
                      <dt className="capitalize text-slate-500">
                        {key.replaceAll("_", " ")}
                      </dt>
                      <dd className="mt-1 font-semibold">{String(value)}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p className="text-sm text-slate-500">
                  Your extracted information will appear here.
                </p>
              )}
            </div>

            <div className="rounded-2xl border border-amber-200 bg-amber-50 p-5">
              <div className="mb-2 flex items-center gap-2 font-semibold text-amber-900">
                <ShieldCheck size={20} />
                Privacy first
              </div>
              <p className="text-sm leading-6 text-amber-900">
                Never enter Aadhaar, PAN, passport numbers or other
                sensitive identifiers. All results are preliminary.
              </p>
            </div>
          </aside>
        </section>

        <ScholarshipRecommendation recommendation={recommendation} />

        <SchemeExplorer />

        <ApplicationTracker />


      </main>
    </div>
  );
}




